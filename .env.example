# Port na hoście, na który nginx (poza kontenerami) robi proxy_pass
WEB_PORT=8435
WEB_WORKERS=3
# wątki na worker (gthread) — wywołania AI nie blokują reszty aplikacji
WEB_THREADS=8

DB_NAME=kompetiq
DB_USER=kompetiq
DB_PASSWORD=zmien_na_silne_haslo
DB_PORT=5432

DJANGO_SECRET_KEY=zmien_na_losowy_klucz
# 1 = tryb debug (tylko lokalnie, nigdy produkcja)
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=kompetiq.devcage.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://kompetiq.devcage.pl
# Lokalnie bez nginx: SERVE_STATIC=1 i COOKIE_SECURE=0 (HTTP). Na serwerze: SERVE_STATIC=0, COOKIE_SECURE=1
SERVE_STATIC=0
COOKIE_SECURE=1
# Nazwa kontenerów: <nazwa>, <nazwa>-db
CONTAINER_NAME=kompetiq

# ── Asystent AI ─────────────────────────────────────────────────────────────────────────────
# Dostawcę wybiera się wyłącznie konfiguracją (bez zmian w kodzie). Bez konfiguracji aplikacja działa,
# a funkcje AI pokazują komunikat o braku konfiguracji.
#
# ASSISTANT_PROVIDER=openai_compat — dowolny serwer zgodny z OpenAI Chat Completions:
#
#   A) Groq (darmowy plan z limitami, dane domyślnie nieużywane do treningu, opcja Zero Data Retention):
#      LLM_BASE_URL=https://api.groq.com/openai/v1
#      LLM_MODEL=openai/gpt-oss-120b
#   B) Google Gemini (darmowy plan; w UE/EOG stosowane warunki jak dla planu płatnego — sprawdź regulamin):
#      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#      LLM_MODEL=gemini-2.5-flash
#   C) PLLuM (polski model MC, licencja otwarta) uruchomiony w infrastrukturze urzędu przez vLLM:
#      docker compose --profile pllum up -d      (usługa „llm” w docker-compose.yml, wymaga GPU NVIDIA)
#      LLM_BASE_URL=http://llm:8000/v1
#      LLM_MODEL=CYFRAGOVPL/PLLuM-12B-instruct-2512
#      LLM_API_KEY=            (pusty, jeśli serwer nie wymaga klucza)
#   D) Bielik / inny model w Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_MODEL=<nazwa modelu>
#
# LLM_JSON_MODE: json_object (domyślnie), json_schema (gdy serwer obsługuje strukturyzowane odpowiedzi),
#                prompt (serwer bez trybu JSON — format wymusza instrukcja i walidacja z ponowieniem)
#
# ASSISTANT_PROVIDER=anthropic — Claude API: ustaw ANTHROPIC_API_KEY (i opcjonalnie ASSISTANT_MODEL)
ASSISTANT_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_JSON_MODE=json_object
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Budżet promptu (darmowe plany mają limity tokenów na minutę; ~3 znaki ≈ 1 token)
ASSISTANT_CONTEXT_CHARS=9000
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
# Próg dopasowania źródeł; poniżej asystent formalny odpowiada „brak informacji w bazie wiedzy”
ASSISTANT_MIN_RETRIEVAL_SCORE=2.0
# limit wywołań asystenta na użytkownika
ASSISTANT_RATE=60/hour

# ── Poczta: EmailLabs (te same dane co robertlewandowski-dev). Ustawiony EMAILLABS_APP_KEY włącza backend EmailLabs.
EMAILLABS_SMTP=
EMAILLABS_APP_KEY=
EMAILLABS_SECRET_KEY=
# Domena nadawcy musi być zweryfikowana na koncie SMTP w EmailLabs
DEFAULT_FROM_EMAIL=KompetIQ <kontakt@robertlewandowski.dev>
# po potwierdzeniu działania wyłącznie przez HTTPS, np. 31536000
SECURE_HSTS_SECONDS=0
